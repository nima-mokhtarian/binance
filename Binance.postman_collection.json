	"auth": {
		"type": "apikey",
		"apikey": [
			{
				"key": "key",
				"value": "X-MBX-APIKEY",
				"type": "string"
			},
			{
				"key": "value",
				"value": "{{apiKey}}",
				"type": "string"
			},
			{
				"key": "in",
				"value": "header",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"const isSigned = (pm.request.url.query.toObject()['signature'] !== undefined) || pm.request.url.query.toObject()['timestamp'] !== undefined || pm.request.body && pm.request.body.mode === 'urlencoded' && pm.request.body.urlencoded.some(p=>p.key==='signature' || p.key==='timestamp');",
					"if (isSigned) {",
					"  const ts = Date.now();",
					"  pm.environment.set('timestamp', ts.toString());",
					"  const recv = pm.environment.get('recvWindow') || '5000';",
					"  pm.environment.set('recvWindow', recv);",
					"  function buildQuery(){",
					"    let pairs = [];",
					"    pm.request.url.query.each(q => {",
					"      if (!q.disabled && q.key && q.value && q.key !== 'signature') {",
					"        pairs.push(encodeURIComponent(q.key)+'='+encodeURIComponent(q.value));",
					"      }",
					"    });",
					"    const hasTs = pm.request.url.query.has('timestamp');",
					"    if (!hasTs) pairs.push('timestamp='+ts);",
					"    const hasRecv = pm.request.url.query.has('recvWindow');",
					"    if (!hasRecv) pairs.push('recvWindow='+recv);",
					"    if (pm.request.body && pm.request.body.mode === 'urlencoded') {",
					"      pm.request.body.urlencoded.forEach(p => {",
					"        if (!p.disabled && p.key && p.value && p.key !== 'signature') {",
					"          pairs.push(encodeURIComponent(p.key)+'='+encodeURIComponent(p.value));",
					"        }",
					"      });",
					"    }",
					"    return pairs.join('&');",
					"  }",
					"  const queryString = buildQuery();",
					"  const secret = pm.environment.get('apiSecret') || '';",
					"  if (!secret) { console.warn('apiSecret not set in environment'); }",
					"  const sig = CryptoJS.HmacSHA256(queryString, secret).toString(CryptoJS.enc.Hex);",
					"  pm.environment.set('signature', sig);",
					"  const method = pm.request.method.toUpperCase();",
					"  if (method === 'GET' || method === 'DELETE') {",
					"    const url = pm.request.url.toString();",
					"    const join = url.includes('?') ? '&' : '?';",
					"    pm.request.url = url + join + queryString + '&signature=' + sig;",
					"  } else {",
					"    if (!pm.request.body) pm.request.body = {};",
					"    pm.request.body.mode = 'urlencoded';",
					"    const params = queryString.split('&').map(kv => {",
					"      const [k,v] = kv.split('=');",
					"      return {key: decodeURIComponent(k), value: decodeURIComponent(v)};",
					"    });",
					"    params.push({key:'signature', value:sig});",
					"    pm.request.body.urlencoded = params;",
					"  }",
					"}"
				]
			}
		}
	]
}